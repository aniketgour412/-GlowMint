# ==============================================================================
# GlowMint Accessories — Environment Configuration (.env.example)
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False
APP_SECRET_KEY=change-this-to-a-very-secure-random-64-char-string-in-production

# Admin Credentials (Initial setup on first startup if not already seeded)
ADMIN_EMAIL=admin@glowmint.in
ADMIN_INITIAL_PASSWORD=ChangeThisPasswordInProd!2026
ADMIN_SESSION_EXPIRE_HOURS=24

# Razorpay Configuration (Prepaid Payments)
# When left empty or set to test keys, the application activates integration-ready simulation mode.
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretKeyHere

# Store Details
STORE_NAME=GlowMint Accessories
STORE_CURRENCY=INR
SUPPORT_EMAIL=support@glowmint.in
SUPPORT_PHONE=+91 98765 43210
